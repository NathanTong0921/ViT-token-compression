{
  "model": "ViT-B/16",
  "model_cache": "cache/clip",
  "data_root": "data/raw/oxford-iiit-pet",
  "manifest_dir": "data/splits/pets-v1",
  "baseline_dir": "results/pets-baseline-v1",
  "image_split": "val",
  "prompt_template": "a photo of a {class_name}, a type of pet.",
  "balance_seed": 2028,
  "seed": 2026,
  "batch_size": 64,
  "num_workers": 4,
  "device": "cuda:0",
  "prune_after": 6,
  "keep_patch_tokens": [
    147,
    98,
    49
  ],
  "identity_atol": 1e-06,
  "task_split": "val",
  "images_per_class": 1,
  "window_size": 2,
  "candidate_count": 64,
  "suffix_batch_size": 64
}
